{
  "name": "cli-bridge",
  "displayName": "cli-bridge",
  "description": "Expose the other AI CLIs installed on your machine (Gemini, Codex, Claude Code, Mistral, opencode, Ollama…) as MCP tools. Spawns the official CLI; no API keys.",
  "author": {
    "name": "JoaoBerné"
  },
  "homepage": "https://github.com/JoaoBerne/cli-bridge-mcp",
  "repository": "https://github.com/JoaoBerne/cli-bridge-mcp",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "multi-model",
    "code-review",
    "delegation"
  ],
  "mcpServers": {
    "cli-bridge": {
      "command": "uvx",
      "args": [
        "cli-bridge-mcp"
      ]
    }
  }
}
